# Node Environment
NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api
REQUEST_SIZE_LIMIT=10mb
TIMEOUT_MS=15000
TIMEZONE=UTC
ENCODING=UTF-8

# Database (PostgreSQL)
DATABASE_URL=postgresql://seyofios:seyofios@localhost:5432/seyofios?schema=public
DATABASE_MAX_CONNECTIONS=10

# Redis Cache
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Firebase Authentication & Admin
FIREBASE_PROJECT_ID=seyofios-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@seyofios-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Internal JWT
JWT_ACCESS_TOKEN_SECRET=dev-jwt-access-secret-32-chars-long!!
JWT_REFRESH_TOKEN_SECRET=dev-jwt-refresh-secret-32-chars-long!
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=30d

# External APIs
GOOGLE_MAPS_API_KEY=
